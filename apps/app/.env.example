# Copy to .env and fill in. Never commit .env.

PUBLIC_APP_URL=http://localhost:4321

# PostHog product analytics. Get these values from PostHog project settings.
PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
PUBLIC_POSTHOG_HOST=your_posthog_host_here

# Privy dashboard → App settings. Enable email, Google and Apple login and Solana embedded wallets.
PUBLIC_PRIVY_APP_ID=
PUBLIC_PRIVY_CLIENT_ID=
PRIVY_APP_SECRET=

# Supabase → Project settings → API. The service role key stays on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mainnet RPC (Helius or similar). Tokenized stocks only exist on mainnet.
SOLANA_RPC_URL=

# Base58 secret key of a funded wallet that pays fees and rent. Keep only a little SOL in it.
RELAYER_SECRET_KEY=

# Wallet that receives gift fees (cash). Defaults to the relayer.
TREASURY_WALLET=

# Any long random string. Vercel sends it to /api/cron/refund-gifts (daily refunds of expired gifts).
CRON_SECRET=

# Jupiter Referral Program account under the Ultra project (referral.jup.ag). Unset = no trading fee.
JUPITER_REFERRAL_ACCOUNT=
# Our trading fee in basis points, 50-255. Jupiter keeps 20% of it.
TRADE_FEE_BPS=50

# Web push, so gifts reach the phone. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Unset = notifications stay in the app's feed and the browser is never asked for permission.
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:help@trymorrow.money
