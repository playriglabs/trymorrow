---
import '@/styles/global.css'
import { PUBLIC_APP_URL } from 'astro:env/client'
import { ClientRouter } from 'astro:transitions'
import { InstallPrompt } from '@/components/install-prompt'
import PostHog from '@/components/posthog.astro'

type Props = {
  title?: string
  description?: string
  image?: string
  imageAlt?: string
  imageWidth?: number
  imageHeight?: number
  robots?: string
}

const {
  title = 'Morrow — Gift stocks and cash',
  description = 'Give a piece of a real company or send cash with Morrow. Share a gift with someone you care about, or start a fund for their future.',
  image,
  imageAlt = 'Morrow — gift stocks and cash',
  imageWidth,
  imageHeight,
  robots = 'index, follow, max-image-preview:large',
} = Astro.props
const url = new URL(Astro.url.pathname, PUBLIC_APP_URL).href
const siteUrl = new URL('/', PUBLIC_APP_URL).href
const imageUrl = new URL(image || '/og-image.jpg', siteUrl).href
const width = imageWidth ?? (!image ? 1200 : undefined)
const height = imageHeight ?? (!image ? 630 : undefined)
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'Morrow',
      url: siteUrl,
      logo: new URL('/trymorrow-logo-rounded.png', siteUrl).href,
      sameAs: ['https://x.com/trymorrow', 'https://www.linkedin.com/company/trymorrow'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'Morrow',
      url: siteUrl,
      inLanguage: 'en',
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${url}#webpage`,
      url,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': `${siteUrl}#website` },
      primaryImageOfPage: { '@type': 'ImageObject', url: imageUrl },
    },
  ],
}).replace(/</g, '\\u003c')
---

<!doctype html>
<html lang="en">
  <head>
    <ClientRouter fallback="swap" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fff7e9" />
    <PostHog />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="application-name" content="Morrow" />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Morrow" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imageUrl} />
    {!image && <meta property="og:image:type" content="image/jpeg" />}
    <meta property="og:image:alt" content={imageAlt} />
    {width && <meta property="og:image:width" content={String(width)} />}
    {height && <meta property="og:image:height" content={String(height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@trymorrow" />
    <meta name="twitter:creator" content="@trymorrow" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" is:inline set:html={structuredData}></script>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/trymorrow-logo-rounded.png?v=5" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Morrow" />
    <script is:inline>
      // Capture the single-use event before any React island has hydrated.
      addEventListener('beforeinstallprompt', (event) => {
        event.preventDefault()
        window.__morrowInstallPrompt = event
      })
      addEventListener('appinstalled', () => {
        window.__morrowInstalled = true
        delete window.__morrowInstallPrompt
      })
    </script>
    <script is:inline>
      // Telegram Mini Apps announce themselves through launch params in the URL (query on
      // current clients, hash on old ones). Only then is telegram-web-app.js worth loading —
      // everyone else would fetch a script they never use, and web push never works in there.
      ;(function () {
        var search = new URLSearchParams(location.search)
        var hash = new URLSearchParams(location.hash.slice(1))
        if (!search.get('tgWebAppData') && !hash.get('tgWebAppData')) return
        window.__morrowTelegram = true
        var script = document.createElement('script')
        script.src = 'https://telegram.org/js/telegram-web-app.js'
        script.onload = function () {
          var app = window.Telegram && window.Telegram.WebApp
          if (!app) return
          app.ready()
          app.expand()
          // A money flow shouldn't die because someone swiped down; keep that gesture ours
          if (app.disableVerticalSwipes) app.disableVerticalSwipes()
          try {
            app.setHeaderColor('#fff7e9')
            app.setBackgroundColor('#fff7e9')
          } catch (e) {}
          // Ask once, ever, for the right to message them when a gift arrives; the popup only
          // shows if they haven't already allowed it or blocked the bot
          try {
            var asked = localStorage.getItem('morrow.telegram.write') === 'asked'
            var person = app.initDataUnsafe && app.initDataUnsafe.user
            if (!asked && person && !person.allows_write_to_pm && app.requestWriteAccess) {
              localStorage.setItem('morrow.telegram.write', 'asked')
              app.requestWriteAccess()
            }
          } catch (e) {}
        }
        document.head.appendChild(script)
      })()
    </script>
  </head>
  <body class="min-h-dvh bg-cream text-ink">
    <main class="mx-auto flex min-h-dvh w-full max-w-107.5 flex-col">
      <InstallPrompt client:only="react" transition:persist="morrow-install" />
      <slot />
    </main>
    <script is:inline>
      // The offline shell and phone notifications both live in the worker; a page that can't
      // register one still works, it just has neither
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}))
      }
    </script>
    <script>
      // Privy draws its modals with styled-components, which writes its rules into <style
      // data-styled> tags in the head. A client-side navigation drops every head element the next
      // page doesn't also have, so after one the Privy island lives on but its modals render with
      // no styles and never appear (Reveal key only worked after a hard refresh). Putting the tag
      // back afterwards isn't enough: the rules go in through insertRule and die with the node.
      // Marking it persisted, with a matching placeholder in the next page, keeps the node itself.
      document.addEventListener('astro:before-swap', (event) => {
        document.head.querySelectorAll('style[data-styled]').forEach((style, index) => {
          const id = style.dataset.astroTransitionPersist ?? `styled-components-${index}`
          style.dataset.astroTransitionPersist = id
          const placeholder = event.newDocument.createElement('style')
          placeholder.dataset.astroTransitionPersist = id
          event.newDocument.head.append(placeholder)
        })
      })
    </script>
  </body>
</html>
