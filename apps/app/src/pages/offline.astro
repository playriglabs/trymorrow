---
import AppLayout from '@/layouts/app-layout.astro'

// Cached by the service worker at install, so it's what shows when the network is gone
export const prerender = true
---

<AppLayout title="Offline — Morrow" description="Morrow needs a connection.">
  <div class="flex flex-1 flex-col items-center justify-center gap-4 px-5 py-10 text-center">
    <h1 class="font-sans text-[30px] leading-[1.15] font-medium tracking-[-0.02em]">
      You’re offline
    </h1>
    <p class="text-stone">
      Morrow needs a connection to show prices and move money. It’ll be here when you’re back.
    </p>
    <button
      type="button"
      onclick="location.reload()"
      class="inline-flex h-14 w-full items-center justify-center rounded-button bg-orange px-5 font-sans text-[17px] font-medium text-white"
    >
      Try again
    </button>
  </div>
</AppLayout>
