---
import TradeScreen from '@/components/screens/trade-screen'
import AppLayout from '@/layouts/app-layout.astro'
import { findStockByTicker } from '@/lib/server/catalog'

const stock = await findStockByTicker(decodeURIComponent(Astro.params.ticker ?? ''))
if (!stock) return Astro.redirect('/buy')

const side = Astro.url.searchParams.get('side') === 'sell' ? 'sell' : 'buy'
---

<AppLayout title={`${stock.name} · Morrow`} image={stock.iconUrl}>
  <TradeScreen client:only="react" ticker={stock.ticker} side={side} />
</AppLayout>
