---
import AppScreen from '@/components/app-screen'
import AppLayout from '@/layouts/app-layout.astro'
import { findStockByTicker } from '@/lib/server/catalog'

const stock = await findStockByTicker(decodeURIComponent(Astro.params.ticker ?? ''))
if (!stock) return Astro.redirect('/stocks')
---

<AppLayout title={`Your ${stock.name} shares — Morrow`} image={stock.iconUrl}>
  <AppScreen
    client:only="react"
    transition:persist="morrow-app"
    screen="holding-screen"
    screenProps={{ mint: stock.mint.toBase58(), ticker: stock.ticker, name: stock.name }}
    routeKey={Astro.url.pathname + Astro.url.search}
  />
</AppLayout>
