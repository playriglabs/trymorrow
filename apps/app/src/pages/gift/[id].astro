---
import { PUBLIC_APP_URL } from 'astro:env/client'
import GiftScreen from '@/components/screens/gift-screen'
import AppLayout from '@/layouts/app-layout.astro'
import { giftContentsLabel } from '@/lib/gifts'
import { findGiftAsset } from '@/lib/server/catalog'
import { isGiftId } from '@/lib/server/gifts'
import { db } from '@/lib/server/supabase'

// Rendered on the server so WhatsApp, iMessage and Telegram show a real preview of the gift
const { id = '' } = Astro.params

const { data: gift, error: giftError } = isGiftId(id)
  ? await db
      .from('gifts')
      .select('status, sender_id, recipient_id, gift_items (mint)')
      .eq('id', id)
      .maybeSingle()
  : { data: null, error: null }
if (giftError) throw giftError

const mints = ((gift?.gift_items ?? []) as { mint: string }[]).map((item) => item.mint)
const [
  { data: sender, error: senderError },
  { data: recipient, error: recipientError },
  foundAssets,
] = gift
  ? await Promise.all([
      db.from('users').select('name').eq('id', gift.sender_id).maybeSingle(),
      gift.recipient_id
        ? db.from('users').select('name').eq('id', gift.recipient_id).maybeSingle()
        : Promise.resolve({ data: null, error: null }),
      Promise.all(mints.map((mint) => findGiftAsset(mint))),
    ])
  : [{ data: null, error: null }, { data: null, error: null }, []]
if (senderError) throw senderError
if (recipientError) throw recipientError

const assets = foundAssets.flatMap((asset) => (asset ? [asset] : []))

const found = Boolean(gift && gift.status !== 'draft')
if (!found) Astro.response.status = 404

const senderName = sender?.name ?? 'Someone'
const recipientName = recipient?.name ?? null
const contents = assets.length > 0 ? giftContentsLabel(assets) : 'gift'
const capitalizedContents = contents.replace(/^./, (character) => character.toUpperCase())

const title = !found
  ? 'Gift not found — Morrow'
  : gift?.status === 'claimed'
    ? recipientName
      ? `${recipientName} claimed ${senderName}’s gift — Morrow`
      : `Gift claimed — Morrow`
    : gift?.status === 'refunded'
      ? `Gift returned to ${senderName} — Morrow`
      : `${senderName} sent you a gift — Morrow`

const description = !found
  ? 'This gift link doesn’t exist.'
  : gift?.status === 'claimed'
    ? recipientName
      ? `${recipientName} opened the ${contents} ${senderName} sent on Morrow.`
      : `This ${contents} gift has been opened and delivered on Morrow.`
    : gift?.status === 'refunded'
      ? `This ${contents} gift was returned to ${senderName} and can no longer be opened.`
      : `${capitalizedContents}, waiting for you on Morrow. Only the person it’s for can open it.`
// The preview is a dynamically generated card with the gift's contents, sender and status
const image = found ? new URL(`/og/gift/${id}.png`, PUBLIC_APP_URL).href : undefined
---

<AppLayout title={title} description={description} image={image}>
  <GiftScreen client:only="react" giftId={id} />
</AppLayout>
